{
  "expo": {
    "name": "CorrectAi",
    "slug": "CorrectAi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "correctai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "CorrectAi a besoin d'accéder à la caméra pour scanner les feuilles de réponses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.CorrectAi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/correctai-splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "CorrectAi a besoin d'accéder à la caméra pour scanner les feuilles de réponses.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
